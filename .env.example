# Copy to `.env` next to post_consume.py and edit it.
# The script loads this file itself; real process environment variables win over
# the values here, so do not duplicate these keys in paperless.conf.
# A key present but empty is an error - delete the key to get its default.

# --- required ----------------------------------------------------------------

# My Profile -> circular arrow button (or POST /api/token/).
PAPERLESS_API_TOKEN=

# paperless-gpt's OCR_LIMIT_PAGES. Copy that value here, and never set it
# higher than paperless-gpt's: paperless-gpt replaces the document text with its
# OCR result, and its own page limit does not protect that text.
# 0 means paperless-gpt is unlimited, in which case every document is queued.
OCR_LIMIT_PAGES=5

# --- optional ----------------------------------------------------------------
# These default to the values shown below, which are defined in post_consume.py.
# Uncomment a key only to override it.

# The scheme is mandatory (without it the client would assume https), and
# localhost works even when ALLOWED_HOSTS is restricted.
#PAPERLESS_API_URL=http://localhost:8000

# Seconds; bounds a hung API so it cannot stall the single-threaded consumer.
#API_TIMEOUT=15

# Must match paperless-gpt's AUTO_TAG / AUTO_OCR_TAG, otherwise the tags are
# added but nothing consumes them.
#AUTO_TAG=paperless-gpt-auto
#OCR_AUTO_TAG=paperless-gpt-ocr-auto
